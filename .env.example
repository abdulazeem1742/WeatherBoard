# OpenWeatherMap API Key (Free tier at https://openweathermap.org/api)
# Note: If omitted, WeatherBoard automatically falls back to Open-Meteo
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# RapidAPI Key for GeoDB Cities API (Free tier at https://rapidapi.com/wirefreethought/api/geodb-cities)
# Used for live city autocomplete search
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
